# 复制为 .env 后按需修改;.env 不入库(§20.2 可迁移性纪律)
# 环境差异只进这里,代码零改动(十二要素)

# ── 应用 ──────────────────────────────────────
APP_ENV=dev                # dev | prod
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:3080
MCP_ENABLED=true
MCP_MAX_TTL_HOURS=24
IMAGE_TAG=dev
GIT_SHA=unknown
# 只信任实际反代网段中的 X-Forwarded-For；宿主开发由 Vite 直连 API，保留回环地址即可。
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# 应用层分布式令牌桶的部署硬上限；运维页可在上限内热调实际值。
# 公网入口仍应在 Cloudflare / Ingress 做边缘防护。
API_RATE_LIMIT_PER_MINUTE=180
API_RATE_LIMIT_BURST=60
# Argon2 每次约 64 MiB；这是运维页可热调并发的部署硬上限。
PASSWORD_HASH_CONCURRENCY=4
JWT_SECRET=dev-only-change-me-32bytes-min!!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
OPS_ACCOUNT=ops@localhost
OPS_PASSWORD=ops-dev-change-me

# ── PostgreSQL ───────────────────────────────
PG_USER=easygpa
PG_PASSWORD=easygpa-dev
PG_DB=easygpa
PG_APP_PASSWORD=easygpa-app-dev
PG_OPS_PASSWORD=easygpa-ops-dev
# 宿主(WSL)上跑 Go 时用 localhost;容器内跑(--profile full)由 compose 覆盖
DATABASE_URL=postgres://easygpa_app:easygpa-app-dev@localhost:5432/easygpa?sslmode=disable
MIGRATIONS_DATABASE_URL=postgres://easygpa:easygpa-dev@localhost:5432/easygpa?sslmode=disable
OPS_DATABASE_URL=postgres://easygpa_ops:easygpa-ops-dev@localhost:5432/easygpa?sslmode=disable

# ── Redis ────────────────────────────────────
REDIS_ADDR=localhost:6379
# 仅外部 Redis 需要；自带的 Compose Redis 不设密码且只绑定本机。
REDIS_PASSWORD=

# ── 对象存储(Garage,纯 S3 协议 §20.3) ────────
# 密钥为开发专用值(Garage 格式:access=GK+24位hex,secret=64位hex);生产必换
S3_ENDPOINT=localhost:3900
S3_PUBLIC_ENDPOINT=localhost:3900
S3_REGION=garage
S3_ACCESS_KEY=GK0000dead0000beef0000cafe
S3_SECRET_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
S3_BUCKET=easygpa
S3_USE_SSL=false
# 只影响预签名 URL 的 scheme,不影响集群内到 Garage 的连接。
# 放到公网时(例如 Cloudflare Tunnel 后面)浏览器必须拿到 https:// 的直传地址,
# 而内部仍然是明文 —— 共用一个开关表达不了这两件事。缺省跟随 S3_USE_SSL。
S3_PUBLIC_USE_SSL=false

# ── 邮件（仅腾讯云 SES SendEmail API，不使用 SMTP） ──
# 推荐只配置 MAIL_SECRET_KEY，然后在 /?v=opsMail 保存以下参数和全部模板 ID。
# 这里提供的是无运维库或应急回退；任一项开始填写后必须形成完整、独立的配置。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SES_REGION=ap-guangzhou
TENCENTCLOUD_SES_FROM=
TENCENTCLOUD_SES_FROM_NAME=EasyGPA Plus 综测平台
TENCENTCLOUD_SES_REPLY_TO=
# JSON：模板名到腾讯云模板 ID。模板名见 asset/mailtemplate/ 与 https://easygpa.guiguisocute.com/deploy/mail
TENCENTCLOUD_SES_TEMPLATE_IDS={}
# 加密运维页保存的 SecretId/SecretKey。32 字节：openssl rand -hex 32
# 换掉它会让数据库内已保存的凭据无法解密，需要在网页上重新填写。
MAIL_SECRET_KEY=
# 留空会自动寻找 asset/mailtemplate；容器镜像已设置为 /app/mailtemplate
MAIL_TEMPLATE_DIR=

# ── 备份（生产必须把离机目录挂到独立存储） ─────
# 宿主直接运行 Go 时使用这两个路径；compose.yaml 内固定为 /backups/local 与 /backups/offsite。
BACKUP_DIR=./tmp/backups
BACKUP_OFFSITE_DIR=
# compose.yaml 中 /backups/offsite 的来源。留空为同机命名卷；正式部署填独立存储的宿主路径，如 /mnt/offsite/easygpa。
BACKUP_OFFSITE_VOLUME=
BACKUP_RETENTION_DAYS=30
# 可选的异地加密副本：32 字节密钥加密运维页保存的桶凭据（openssl rand -hex 32）；
# RECIPIENT 只填 age 公钥（age1...），私钥离线保管，不要放在服务器上。
BACKUP_REMOTE_SECRET_KEY=
BACKUP_REMOTE_RECIPIENT=

# ── LLM(AI 材料整理助手 §19,OpenAI 兼容端点) ──
# 正常部署在 /?v=opsAgent 管理多个供应商，并按 material.vision、
# material.compose、knowledge.ocr、agent.text、agent.vision 五个用途路由。
# 下面的单端点字段仅供旧部署迁移和没有 OPS_DATABASE_URL 的精简部署回退。
AI_ENABLED=false
# 仅自建内网模型端点需要；开启会放宽 AI HTTP 客户端的私网 SSRF 防护。
AI_ALLOW_PRIVATE_NETWORK=false
# 加密网页保存的模型 API Key。生产必须固定为 32 字节；开发环境留空会使用固定的本机默认值。
# 换掉后旧密文无法解开。
# 生成方式：openssl rand -hex 32
AI_CONFIG_SECRET_KEY=
LLM_BASE_URL=https://api.example.org/v1
# 环境变量仍作为旧版安全回退；新部署应从运维页为每个供应商分别保存 Key。
LLM_API_KEY=
LLM_TEXT_MODEL=
LLM_VISION_MODEL=
# 留空时知识问答继承 LLM_TEXT_MODEL；也可在 /?v=opsAgent 热配置。
LLM_AGENT_MODEL=
LLM_TIMEOUT=90s
AI_MAX_BATCH=100
AI_CONCURRENCY=2
AI_MAX_PDF_PAGES=64

# ---- 前端（写进 frontend/.env.local,不入库） ----
# dev server 把 /api 转发到哪。后端端口被别的项目占用时改这里
VITE_API_PROXY=http://127.0.0.1:8080
# 仅保留给尚未接入运行时状态的旧 AI 占位区；材料整理入口读取 /ai/status。
VITE_AI_ENABLED=false

# ── 全容器本地开发（compose.dev.yaml，可选覆盖） ──
DEV_FRONTEND_PORT=35173
DEV_API_PORT=38080
DEV_POSTGRES_PORT=35432
DEV_REDIS_PORT=36379
DEV_S3_PORT=33900
DEV_GARAGE_ADMIN_PORT=33903
# Docker Desktop 的 Windows 目录挂载使用轮询，数值越小反馈越快、CPU 占用越高。
DEV_WATCH_INTERVAL_MS=500
